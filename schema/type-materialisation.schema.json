{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datahub/type-materialisation.schema.json",
  "title": "Type Materialisation Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": {
      "$ref": "#/$defs/specificationId"
    },
    "description": {
      "type": "string"
    },
    "extends": {
      "$ref": "#/$defs/specificationId",
      "description": "Parent specification id. The parent file is expected in the same folder as <id>.yaml."
    },
    "control_data": {
      "$ref": "#/$defs/controlData"
    },
    "source": {
      "$ref": "#/$defs/sourcePatch"
    },
    "target": {
      "$ref": "#/$defs/targetPatch"
    }
  },
  "allOf": [
    {
      "required": ["source", "target"],
      "properties": {
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/csvSource"
            },
            {
              "$ref": "#/$defs/tableSource"
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/fullTarget"
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "format": {
                "const": "csv"
              }
            },
            "required": ["format"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "fields": {
                "items": {
                  "$ref": "#/$defs/csvField"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "format": {
                "const": "csv"
              },
              "header": {
                "const": false
              }
            },
            "required": ["format", "header"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "fields": {
                "items": {
                  "$ref": "#/$defs/csvNoHeaderField"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "format": {
                "const": "table"
              }
            },
            "required": ["format"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "fields": {
                "items": {
                  "$ref": "#/$defs/tableField"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "specificationId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "templatedString": {
      "type": "string",
      "minLength": 1
    },
    "controlData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "materialisation_type": {
          "type": "string",
          "enum": ["view", "materialised_view", "table"]
        },
        "failure_mode": {
          "type": "string",
          "enum": ["fail_file", "quarantine_row"]
        },
        "quarantine": {
          "$ref": "#/$defs/quarantineTable"
        },
        "job": {
          "$ref": "#/$defs/jobTable"
        }
      }
    },
    "quarantineTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "database": {
          "$ref": "#/$defs/templatedString"
        },
        "schema": {
          "$ref": "#/$defs/templatedString"
        },
        "table": {
          "$ref": "#/$defs/templatedString"
        }
      }
    },
    "jobTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "database": {
          "$ref": "#/$defs/templatedString"
        },
        "schema": {
          "$ref": "#/$defs/templatedString"
        },
        "table": {
          "$ref": "#/$defs/templatedString"
        }
      }
    },
    "sourcePatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": ["csv", "table"]
        },
        "separator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "quote_char": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "row_terminator": {
          "type": "string",
          "minLength": 1
        },
        "quoting": {
          "type": "string",
          "enum": ["minimal", "all", "non_numeric", "none", "notnull", "strings"]
        },
        "header": {
          "type": "boolean"
        },
        "database": {
          "$ref": "#/$defs/templatedString"
        },
        "schema": {
          "$ref": "#/$defs/templatedString"
        },
        "table": {
          "$ref": "#/$defs/templatedString"
        }
      }
    },
    "csvSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "header"],
      "properties": {
        "format": {
          "const": "csv"
        },
        "separator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "quote_char": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "row_terminator": {
          "type": "string",
          "minLength": 1
        },
        "quoting": {
          "type": "string",
          "enum": ["minimal", "all", "non_numeric", "none", "notnull", "strings"]
        },
        "header": {
          "type": "boolean"
        }
      }
    },
    "tableSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "database", "schema", "table"],
      "properties": {
        "format": {
          "const": "table"
        },
        "database": {
          "$ref": "#/$defs/templatedString"
        },
        "schema": {
          "$ref": "#/$defs/templatedString"
        },
        "table": {
          "$ref": "#/$defs/templatedString"
        }
      }
    },
    "targetPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/specificationId"
        },
        "database": {
          "$ref": "#/$defs/templatedString"
        },
        "schema": {
          "$ref": "#/$defs/templatedString"
        },
        "table_name": {
          "$ref": "#/$defs/templatedString"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fieldPatch"
          }
        }
      }
    },
    "fullTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "database", "schema", "fields"],
      "properties": {
        "id": {
          "$ref": "#/$defs/specificationId"
        },
        "database": {
          "$ref": "#/$defs/templatedString"
        },
        "schema": {
          "$ref": "#/$defs/templatedString"
        },
        "table_name": {
          "$ref": "#/$defs/templatedString"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fullField"
          }
        }
      }
    },
    "fieldPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "not": {
        "properties": {
          "id": {
            "$ref": "#/$defs/reservedAuditFieldId"
          }
        },
        "required": ["id"]
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/specificationId"
        },
        "source": {
          "$ref": "#/$defs/fieldSource"
        },
        "data_type": {
          "$ref": "#/$defs/templatedString"
        },
        "nullable": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        },
        "transforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformRule"
          }
        },
        "validations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validationRule"
          }
        }
      }
    },
    "fullField": {
      "allOf": [
        {
          "$ref": "#/$defs/fieldPatch"
        },
        {
          "required": ["source", "data_type"]
        }
      ]
    },
    "fieldSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pos": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "$ref": "#/$defs/templatedString"
        }
      }
    },
    "csvField": {
      "allOf": [
        {
          "$ref": "#/$defs/fullField"
        },
        {
          "properties": {
            "source": {
              "anyOf": [
                {
                  "required": ["pos"]
                },
                {
                  "required": ["column"]
                }
              ]
            }
          }
        }
      ]
    },
    "csvNoHeaderField": {
      "allOf": [
        {
          "$ref": "#/$defs/csvField"
        },
        {
          "properties": {
            "source": {
              "required": ["pos"],
              "not": {
                "required": ["column"]
              }
            }
          }
        }
      ]
    },
    "tableField": {
      "allOf": [
        {
          "$ref": "#/$defs/fullField"
        },
        {
          "properties": {
            "source": {
              "required": ["column"],
              "not": {
                "required": ["pos"]
              }
            }
          }
        }
      ]
    },
    "transformRule": {
      "oneOf": [
        {
          "$ref": "#/$defs/trimTransform"
        },
        {
          "$ref": "#/$defs/parseDateTransform"
        },
        {
          "$ref": "#/$defs/parseTimestampTransform"
        },
        {
          "$ref": "#/$defs/roundTransform"
        },
        {
          "$ref": "#/$defs/customTransform"
        }
      ]
    },
    "trimTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "trim"
        },
        "side": {
          "type": "string",
          "enum": ["both", "left", "right"]
        }
      }
    },
    "parseDateTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "format"],
      "properties": {
        "type": {
          "const": "parse_date"
        },
        "format": {
          "$ref": "#/$defs/templatedString"
        }
      }
    },
    "parseTimestampTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "format"],
      "properties": {
        "type": {
          "const": "parse_timestamp"
        },
        "format": {
          "$ref": "#/$defs/templatedString"
        }
      }
    },
    "roundTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scale"],
      "properties": {
        "type": {
          "const": "round"
        },
        "scale": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "string",
          "enum": ["half_up", "half_even", "down", "up"]
        }
      }
    },
    "customTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "macro"],
      "properties": {
        "type": {
          "const": "custom"
        },
        "macro": {
          "$ref": "#/$defs/dbtMacroName"
        }
      }
    },
    "dbtMacroName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)?$"
    },
    "validationRule": {
      "oneOf": [
        {
          "$ref": "#/$defs/minLengthValidation"
        },
        {
          "$ref": "#/$defs/maxLengthValidation"
        },
        {
          "$ref": "#/$defs/regexValidation"
        },
        {
          "$ref": "#/$defs/allowedValuesValidation"
        },
        {
          "$ref": "#/$defs/minValueValidation"
        },
        {
          "$ref": "#/$defs/maxValueValidation"
        },
        {
          "$ref": "#/$defs/precisionValidation"
        },
        {
          "$ref": "#/$defs/customValidation"
        }
      ]
    },
    "minLengthValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "const": "min_length"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "maxLengthValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "const": "max_length"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "regexValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "pattern"],
      "properties": {
        "type": {
          "const": "regex"
        },
        "pattern": {
          "$ref": "#/$defs/templatedString"
        }
      }
    },
    "allowedValuesValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "values"],
      "properties": {
        "type": {
          "const": "allowed_values"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scalarValue"
          }
        }
      }
    },
    "minValueValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "const": "min_value"
        },
        "value": {
          "$ref": "#/$defs/scalarValue"
        }
      }
    },
    "maxValueValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "const": "max_value"
        },
        "value": {
          "$ref": "#/$defs/scalarValue"
        }
      }
    },
    "precisionValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "precision"],
      "properties": {
        "type": {
          "const": "precision"
        },
        "precision": {
          "type": "integer",
          "minimum": 1
        },
        "scale": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "customValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "macro"],
      "properties": {
        "type": {
          "const": "custom"
        },
        "macro": {
          "$ref": "#/$defs/dbtMacroName"
        }
      }
    },
    "scalarValue": {
      "type": ["string", "number", "integer", "boolean", "null"]
    },
    "reservedAuditFieldId": {
      "type": "string",
      "pattern": "^([Aa][Uu][Dd][Ii][Tt]_[Dd][Aa][Tt][Aa]_[Pp][Rr][Oo][Cc][Ee][Ss][Ss]_[Kk][Ee][Yy]|[Aa][Uu][Dd][Ii][Tt]_[Cc][Rr][Ee][Aa][Tt][Ee][Dd]_[Dd][Aa][Tt][Ee][Tt][Ii][Mm][Ee]|[Aa][Uu][Dd][Ii][Tt]_[Ll][Aa][Ss][Tt]_[Cc][Hh][Aa][Nn][Gg][Ee][Dd]_[Dd][Aa][Tt][Ee][Tt][Ii][Mm][Ee])$"
    }
  }
}
