{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datahub/type-materialisation.schema.json",
  "title": "Type Materialisation Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": {
      "$ref": "#/$defs/specificationId"
    },
    "description": {
      "type": "string"
    },
    "extends": {
      "$ref": "#/$defs/specificationId",
      "description": "Parent specification id. Parent files are resolved from the child folder and runtime spec paths as <id>.yaml or <id>.yml."
    },
    "control_data": {
      "$ref": "#/$defs/controlData"
    },
    "source": {
      "$ref": "#/$defs/sourcePatch"
    },
    "target": {
      "$ref": "#/$defs/targetPatch"
    }
  },
  "allOf": [
    {
      "required": ["control_data", "source", "target"],
      "properties": {
        "control_data": {
          "required": ["change_type"]
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/csvSource"
            },
            {
              "$ref": "#/$defs/tableSource"
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/fullTarget"
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "format": {
                "const": "csv"
              }
            },
            "required": ["format"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "fields": {
                "items": {
                  "$ref": "#/$defs/csvField"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "format": {
                "const": "csv"
              },
              "header": {
                "const": false
              }
            },
            "required": ["format", "header"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "fields": {
                "items": {
                  "$ref": "#/$defs/csvNoHeaderField"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "format": {
                "const": "table"
              }
            },
            "required": ["format"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "fields": {
                "items": {
                  "$ref": "#/$defs/tableField"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "format": {
                "const": "csv"
              },
              "load_method": {
                "const": "dbt_seed"
              }
            },
            "required": ["format", "load_method"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "source": {
            "required": ["seed"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "format": {
                "const": "csv"
              }
            },
            "required": ["format", "seed"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "load_method": {
                "const": "dbt_seed"
              }
            },
            "required": ["load_method"]
          }
        }
      }
    }
  ],
  "$defs": {
    "specificationId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "templatedString": {
      "type": "string",
      "minLength": 1
    },
    "controlData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "materialisation_type": {
          "type": "string",
          "enum": ["table"]
        },
        "failure_mode": {
          "type": "string",
          "enum": ["fail_load", "quarantine_row"]
        },
        "validation_enabled": {
          "type": "boolean",
          "default": true
        },
        "change_type": {
          "type": "string",
          "enum": ["scd1", "scd2_manual", "scd2_auto", "scd2_derived"]
        },
        "truncate_before_load": {
          "type": "boolean",
          "default": false
        },
        "business_key": {
          "$ref": "#/$defs/businessKey"
        },
        "skip_business_key": {
          "type": "boolean",
          "default": false
        },
        "skip_surrogate_key": {
          "type": "boolean",
          "default": false
        },
        "business_data_hash": {
          "$ref": "#/$defs/businessDataHash"
        },
        "staging_schema": {
          "$ref": "#/$defs/templatedString"
        },
        "scd": {
          "$ref": "#/$defs/scdConfig"
        },
        "quarantine": {
          "$ref": "#/$defs/quarantineTable"
        },
        "job": {
          "$ref": "#/$defs/jobTable"
        },
        "incremental_bookmark": {
          "$ref": "#/$defs/incrementalBookmark"
        }
      }
    },
    "businessKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/specificationId"
          }
        }
      }
    },
    "businessDataHash": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skip_business_data_hash": {
          "type": "boolean",
          "default": false
        },
        "business_data_hash_mode": {
          "type": "string",
          "enum": ["exclude", "include"],
          "default": "exclude"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/specificationId"
          }
        }
      }
    },
    "quarantineTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "database": {
          "$ref": "#/$defs/templatedString"
        },
        "schema": {
          "$ref": "#/$defs/templatedString"
        },
        "table": {
          "$ref": "#/$defs/templatedString"
        }
      }
    },
    "jobTable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "database": {
          "$ref": "#/$defs/templatedString"
        },
        "schema": {
          "$ref": "#/$defs/templatedString"
        },
        "table": {
          "$ref": "#/$defs/templatedString"
        }
      }
    },
    "incrementalBookmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bookmark_relation", "source_relation"],
      "properties": {
        "bookmark_relation": {
          "$ref": "#/$defs/templatedString"
        },
        "source_relation": {
          "$ref": "#/$defs/templatedString"
        },
        "source_timestamp_column": {
          "$ref": "#/$defs/specificationId",
          "default": "AIRFLOW_DAG_TIME"
        },
        "pipeline_name": {
          "$ref": "#/$defs/templatedString"
        }
      }
    },
    "scdConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delete_detection": {
          "$ref": "#/$defs/scdDeleteDetection"
        },
        "insert_time": {
          "$ref": "#/$defs/scalarValue"
        },
        "timestamp_data_type": {
          "type": "string",
          "enum": ["timestamp_ltz", "timestamp_tz", "timestamp_ntz"],
          "default": "timestamp_ntz"
        },
        "validity": {
          "$ref": "#/$defs/scd2Validity"
        },
        "scd2_auto_from_sot": {
          "type": "boolean"
        },
        "scd2_validation": {
          "type": "string",
          "enum": ["continuous", "sparse"],
          "default": "continuous"
        },
        "scd2_validation_enabled": {
          "type": "boolean",
          "default": true
        },
        "derivation_scope": {
          "type": "string",
          "enum": ["affected_keys"],
          "default": "affected_keys"
        },
        "validation_scope": {
          "type": "string",
          "enum": ["affected_window", "full_target"],
          "default": "affected_window"
        },
        "window_strategy": {
          "type": "string",
          "enum": ["previous_and_next"],
          "default": "previous_and_next"
        },
        "current_flag": {
          "$ref": "#/$defs/scdCurrentFlag"
        },
        "deleted_flag": {
          "$ref": "#/$defs/scdDeletedFlag"
        },
        "deduplicate": {
          "$ref": "#/$defs/scdDeduplicate"
        },
        "update_mode": {
          "type": "string",
          "enum": ["append_only", "upsert"],
          "default": "append_only"
        },
        "update_key": {
          "$ref": "#/$defs/scdUpdateKey"
        }
      }
    },
    "scdValidFromDatetime": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["expression"]
        },
        {
          "required": ["source_column"]
        }
      ],
      "properties": {
        "expression": {
          "$ref": "#/$defs/templatedString"
        },
        "source_column": {
          "$ref": "#/$defs/specificationId"
        }
      }
    },
    "scd2Validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid_from", "valid_to"],
      "properties": {
        "data_type": {
          "type": "string",
          "enum": ["date", "timestamp_ltz", "timestamp_tz", "timestamp_ntz"],
          "default": "timestamp_ntz"
        },
        "valid_from": { "$ref": "#/$defs/scd2ValidityBoundary" },
        "valid_to": { "$ref": "#/$defs/scd2ValidityBoundary" }
      }
    },
    "scd2ValidityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column"],
      "properties": {
        "column": { "$ref": "#/$defs/specificationId" },
        "source": { "$ref": "#/$defs/fieldSource" },
        "transforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/transformRule" }
        },
        "nullable": { "type": "boolean" },
        "validations": {
          "type": "array",
          "items": { "$ref": "#/$defs/validationRule" }
        },
        "offset": { "$ref": "#/$defs/scdDatetimeOffset" },
        "end_of_time": { "$ref": "#/$defs/templatedString" }
      }
    },
    "scdValidToDatetime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["next_valid_from"],
          "default": "next_valid_from"
        },
        "offset": {
          "$ref": "#/$defs/scdDatetimeOffset"
        },
        "end_of_time": {
          "$ref": "#/$defs/templatedString"
        }
      }
    },
    "scdDatetimeOffset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "value"],
      "properties": {
        "unit": {
          "type": "string",
          "enum": ["day", "nanosecond", "second"]
        },
        "value": {
          "type": "integer"
        }
      }
    },
    "scdCurrentFlag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["latest_per_business_key"],
          "default": "latest_per_business_key"
        }
      }
    },
    "scdDeletedFlag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["fixed"],
          "default": "fixed"
        },
        "value": {
          "$ref": "#/$defs/scalarValue"
        }
      }
    },
    "scdDeduplicate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "partition_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/specificationId"
          }
        },
        "order_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scdDeduplicateOrderBy"
          }
        }
      }
    },
    "scdDeduplicateOrderBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column"],
      "properties": {
        "column": {
          "$ref": "#/$defs/specificationId"
        },
        "direction": {
          "type": "string",
          "enum": ["asc", "desc"],
          "default": "desc"
        },
        "nulls": {
          "type": "string",
          "enum": ["first", "last"],
          "default": "last"
        }
      }
    },
    "scdUpdateKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/specificationId"
          }
        }
      }
    },
    "scdDeleteDetection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "field", "value"],
      "properties": {
        "mode": {
          "const": "field"
        },
        "field": {
          "$ref": "#/$defs/specificationId"
        },
        "value": {
          "$ref": "#/$defs/scalarValue"
        }
      }
    },
    "sourcePatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": ["csv", "table"]
        },
        "delimiter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "quotechar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "lineterminator": {
          "type": "string",
          "minLength": 1
        },
        "quoting": {
          "type": "string",
          "enum": ["minimal", "all"]
        },
        "load_method": {
          "type": "string",
          "enum": ["stage", "dbt_seed"]
        },
        "header": {
          "type": "boolean"
        },
        "location": {
          "$ref": "#/$defs/csvSourceLocation"
        },
        "seed": {
          "$ref": "#/$defs/csvSourceSeed"
        },
        "upload": {
          "$ref": "#/$defs/csvSourceUpload"
        },
        "database": {
          "$ref": "#/$defs/templatedString"
        },
        "schema": {
          "$ref": "#/$defs/templatedString"
        },
        "table": {
          "$ref": "#/$defs/templatedString"
        },
        "query": {
          "$ref": "#/$defs/templatedString"
        },
        "flatten": {
          "$ref": "#/$defs/tableSourceFlatten"
        }
      }
    },
    "csvSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "header"],
      "properties": {
        "format": {
          "const": "csv"
        },
        "delimiter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "quotechar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "lineterminator": {
          "type": "string",
          "minLength": 1
        },
        "quoting": {
          "type": "string",
          "enum": ["minimal", "all"]
        },
        "load_method": {
          "type": "string",
          "enum": ["stage", "dbt_seed"]
        },
        "header": {
          "type": "boolean"
        },
        "location": {
          "$ref": "#/$defs/csvSourceLocation"
        },
        "seed": {
          "$ref": "#/$defs/csvSourceSeed"
        },
        "upload": {
          "$ref": "#/$defs/csvSourceUpload"
        }
      }
    },
    "csvSourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "database": {
          "$ref": "#/$defs/templatedString"
        },
        "schema": {
          "$ref": "#/$defs/templatedString"
        },
        "stage": {
          "$ref": "#/$defs/templatedString"
        },
        "filename": {
          "$ref": "#/$defs/templatedString"
        }
      }
    },
    "csvSourceSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": {
          "$ref": "#/$defs/templatedString"
        },
        "name": {
          "$ref": "#/$defs/specificationId"
        },
        "database": {
          "$ref": "#/$defs/templatedString"
        },
        "schema": {
          "$ref": "#/$defs/templatedString"
        }
      }
    },
    "csvSourceUpload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "const": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "file", "overwrite"],
          "properties": {
            "enabled": {
              "const": true
            },
            "file": {
              "$ref": "#/$defs/templatedString"
            },
            "overwrite": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "tableSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "anyOf": [
        {
          "required": ["schema", "table"]
        },
        {
          "required": ["query"]
        }
      ],
      "properties": {
        "format": {
          "const": "table"
        },
        "database": {
          "$ref": "#/$defs/templatedString"
        },
        "schema": {
          "$ref": "#/$defs/templatedString"
        },
        "table": {
          "$ref": "#/$defs/templatedString"
        },
        "query": {
          "$ref": "#/$defs/templatedString"
        },
        "flatten": {
          "$ref": "#/$defs/tableSourceFlatten"
        }
      }
    },
    "tableSourceFlatten": {
      "oneOf": [
        {
          "$ref": "#/$defs/tableSourceFlattenEntry"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tableSourceFlattenEntry"
          }
        }
      ]
    },
    "tableSourceFlattenEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column", "alias"],
      "properties": {
        "column": {
          "$ref": "#/$defs/templatedString"
        },
        "path": {
          "$ref": "#/$defs/templatedString"
        },
        "alias": {
          "$ref": "#/$defs/specificationId"
        },
        "outer": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": ["object", "array", "both"]
        }
      }
    },
    "targetPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/specificationId"
        },
        "database": {
          "$ref": "#/$defs/templatedString"
        },
        "schema": {
          "$ref": "#/$defs/templatedString"
        },
        "table_name": {
          "$ref": "#/$defs/templatedString"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "tag_application": {
          "type": "string",
          "enum": ["alter_table", "apply_governance"],
          "default": "alter_table"
        },
        "apply_governance_procedure": {
          "$ref": "#/$defs/templatedString"
        },
        "governance_contract": {
          "$ref": "#/$defs/governanceContract"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fieldPatch"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tag_application": {
                "const": "apply_governance"
              }
            },
            "required": ["tag_application"]
          },
          "then": {
            "required": ["apply_governance_procedure"]
          }
        }
      ]
    },
    "fullTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "fields"],
      "properties": {
        "id": {
          "$ref": "#/$defs/specificationId"
        },
        "database": {
          "$ref": "#/$defs/templatedString"
        },
        "schema": {
          "$ref": "#/$defs/templatedString"
        },
        "table_name": {
          "$ref": "#/$defs/templatedString"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "tag_application": {
          "type": "string",
          "enum": ["alter_table", "apply_governance"],
          "default": "alter_table"
        },
        "apply_governance_procedure": {
          "$ref": "#/$defs/templatedString"
        },
        "governance_contract": {
          "$ref": "#/$defs/governanceContract"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fullField"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tag_application": {
                "const": "apply_governance"
              }
            },
            "required": ["tag_application"]
          },
          "then": {
            "required": ["apply_governance_procedure"]
          }
        }
      ]
    },
    "fieldPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "not": {
        "properties": {
          "id": {
            "$ref": "#/$defs/reservedGeneratedFieldId"
          }
        },
        "required": ["id"]
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/specificationId"
        },
        "source": {
          "$ref": "#/$defs/fieldSource"
        },
        "data_type": {
          "$ref": "#/$defs/templatedString"
        },
        "nullable": {
          "type": "boolean"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "description": {
          "type": "string"
        },
        "unique": {
          "type": "boolean"
        },
        "transforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformRule"
          }
        },
        "validations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validationRule"
          }
        }
      }
    },
    "fullField": {
      "allOf": [
        {
          "$ref": "#/$defs/fieldPatch"
        },
        {
          "required": ["data_type", "source"]
        }
      ]
    },
    "fieldSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pos": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "$ref": "#/$defs/templatedString"
        },
        "snowflake_path": {
          "$ref": "#/$defs/templatedString"
        },
        "default_value": {
          "$ref": "#/$defs/scalarValue"
        },
        "default_from_field": {
          "$ref": "#/$defs/specificationId"
        },
        "macro": {
          "$ref": "#/$defs/pythonMacroName"
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/scalarValue"
          }
        },
        "fixed_value": {
          "$ref": "#/$defs/scalarValue"
        }
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/scalarValue"
      }
    },
    "governanceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table"],
      "properties": {
        "table": {
          "$ref": "#/$defs/templatedString"
        },
        "source": {
          "$ref": "#/$defs/templatedString"
        },
        "version": {
          "$ref": "#/$defs/scalarValue"
        }
      }
    },
    "csvField": {
      "allOf": [
        {
          "$ref": "#/$defs/fullField"
        },
        {
          "properties": {
            "source": {
              "anyOf": [
                {
                  "required": ["pos"]
                },
                {
                  "required": ["column"]
                },
                {
                  "required": ["macro"]
                },
                {
                  "required": ["fixed_value"]
                }
              ]
            }
          }
        }
      ]
    },
    "csvNoHeaderField": {
      "allOf": [
        {
          "$ref": "#/$defs/csvField"
        },
        {
          "properties": {
            "source": {
              "anyOf": [
                {
                  "required": ["pos"]
                },
                {
                  "required": ["macro"]
                },
                {
                  "required": ["fixed_value"]
                }
              ],
              "not": {
                "required": ["column"]
              }
            }
          }
        }
      ]
    },
    "tableField": {
      "allOf": [
        {
          "$ref": "#/$defs/fullField"
        },
        {
          "properties": {
            "source": {
              "anyOf": [
                {
                  "required": ["column"]
                },
                {
                  "required": ["default_value"]
                },
                {
                  "required": ["default_from_field"]
                },
                {
                  "required": ["macro"]
                },
                {
                  "required": ["fixed_value"]
                }
              ],
              "not": {
                "required": ["pos"]
              }
            }
          }
        }
      ]
    },
    "transformRule": {
      "oneOf": [
        {
          "$ref": "#/$defs/trimTransform"
        },
        {
          "$ref": "#/$defs/parseDateTransform"
        },
        {
          "$ref": "#/$defs/parseTimestampTransform"
        },
        {
          "$ref": "#/$defs/roundTransform"
        },
        {
          "$ref": "#/$defs/customTransform"
        }
      ]
    },
    "trimTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "trim"
        },
        "side": {
          "type": "string",
          "enum": ["both", "left", "right"]
        }
      }
    },
    "parseDateTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "format"],
      "properties": {
        "type": {
          "const": "parse_date"
        },
        "format": {
          "$ref": "#/$defs/templatedString"
        }
      }
    },
    "parseTimestampTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "format"],
      "properties": {
        "type": {
          "const": "parse_timestamp"
        },
        "format": {
          "$ref": "#/$defs/templatedString"
        },
        "timezone_if_missing": {
          "type": "string",
          "enum": ["Z", "UTC", "local"]
        },
        "time_if_missing": {
          "type": "string",
          "enum": ["start_of_day", "end_of_day"]
        }
      }
    },
    "roundTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scale"],
      "properties": {
        "type": {
          "const": "round"
        },
        "scale": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "string",
          "enum": ["half_up", "half_even", "down", "up"]
        }
      }
    },
    "customTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "macro"],
      "properties": {
        "type": {
          "const": "custom"
        },
        "macro": {
          "$ref": "#/$defs/pythonMacroName"
        }
      }
    },
    "pythonMacroName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "validationRule": {
      "oneOf": [
        {
          "$ref": "#/$defs/minLengthValidation"
        },
        {
          "$ref": "#/$defs/maxLengthValidation"
        },
        {
          "$ref": "#/$defs/regexValidation"
        },
        {
          "$ref": "#/$defs/allowedValuesValidation"
        },
        {
          "$ref": "#/$defs/minValueValidation"
        },
        {
          "$ref": "#/$defs/maxValueValidation"
        },
        {
          "$ref": "#/$defs/precisionValidation"
        },
        {
          "$ref": "#/$defs/customValidation"
        }
      ]
    },
    "minLengthValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "const": "min_length"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "maxLengthValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "const": "max_length"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "regexValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "pattern"],
      "properties": {
        "type": {
          "const": "regex"
        },
        "pattern": {
          "$ref": "#/$defs/templatedString"
        }
      }
    },
    "allowedValuesValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "values"],
      "properties": {
        "type": {
          "const": "allowed_values"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scalarValue"
          }
        }
      }
    },
    "minValueValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "const": "min_value"
        },
        "value": {
          "$ref": "#/$defs/scalarValue"
        }
      }
    },
    "maxValueValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {
          "const": "max_value"
        },
        "value": {
          "$ref": "#/$defs/scalarValue"
        }
      }
    },
    "precisionValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "precision"],
      "properties": {
        "type": {
          "const": "precision"
        },
        "precision": {
          "type": "integer",
          "minimum": 1
        },
        "scale": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "customValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "macro"],
      "properties": {
        "type": {
          "const": "custom"
        },
        "macro": {
          "$ref": "#/$defs/pythonMacroName"
        }
      }
    },
    "scalarValue": {
      "type": ["string", "number", "integer", "boolean", "null"]
    },
    "reservedGeneratedFieldId": {
      "type": "string",
      "pattern": "^([Aa][Uu][Dd][Ii][Tt]_[Dd][Aa][Tt][Aa]_[Pp][Rr][Oo][Cc][Ee][Ss][Ss]_[Kk][Ee][Yy]|[Aa][Uu][Dd][Ii][Tt]_[Cc][Rr][Ee][Aa][Tt][Ee][Dd]_[Dd][Aa][Tt][Ee][Tt][Ii][Mm][Ee]|[Aa][Uu][Dd][Ii][Tt]_[Ll][Aa][Ss][Tt]_[Cc][Hh][Aa][Nn][Gg][Ee][Dd]_[Dd][Aa][Tt][Ee][Tt][Ii][Mm][Ee]|[Bb][Uu][Ss][Ii][Nn][Ee][Ss][Ss]_[Dd][Aa][Tt][Aa]_[Hh][Aa][Ss][Hh])$"
    }
  }
}
