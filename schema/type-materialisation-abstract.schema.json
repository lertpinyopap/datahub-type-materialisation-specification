{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datahub/type-materialisation-abstract.schema.json",
  "title": "Abstract Type Materialisation Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": {
      "$ref": "type-materialisation.schema.json#/$defs/specificationId"
    },
    "description": {
      "type": "string"
    },
    "extends": {
      "$ref": "type-materialisation.schema.json#/$defs/specificationId",
      "description": "Parent specification id. Parent files are resolved from the child folder and runtime spec paths as <id>.yaml or <id>.yml."
    },
    "control_data": {
      "$ref": "type-materialisation.schema.json#/$defs/controlData"
    },
    "source": {
      "$ref": "type-materialisation.schema.json#/$defs/sourcePatch"
    },
    "target": {
      "$ref": "type-materialisation.schema.json#/$defs/targetPatch"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "format": {
                "const": "csv"
              }
            },
            "required": ["format"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "fields": {
                "items": {
                  "$ref": "#/$defs/csvFieldPatch"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "format": {
                "const": "csv"
              },
              "header": {
                "const": false
              }
            },
            "required": ["format", "header"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "fields": {
                "items": {
                  "$ref": "#/$defs/csvNoHeaderFieldPatch"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "format": {
                "const": "table"
              }
            },
            "required": ["format"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "fields": {
                "items": {
                  "$ref": "#/$defs/tableFieldPatch"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "csvFieldPatch": {
      "allOf": [
        {
          "$ref": "type-materialisation.schema.json#/$defs/fieldPatch"
        },
        {
          "properties": {
            "source": {
              "anyOf": [
                {
                  "required": ["pos"]
                },
                {
                  "required": ["column"]
                },
                {
                  "required": ["fixed_value"]
                }
              ]
            }
          }
        }
      ]
    },
    "csvNoHeaderFieldPatch": {
      "allOf": [
        {
          "$ref": "#/$defs/csvFieldPatch"
        },
        {
          "properties": {
            "source": {
              "anyOf": [
                {
                  "required": ["pos"]
                },
                {
                  "required": ["fixed_value"]
                }
              ],
              "not": {
                "required": ["column"]
              }
            }
          }
        }
      ]
    },
    "tableFieldPatch": {
      "allOf": [
        {
          "$ref": "type-materialisation.schema.json#/$defs/fieldPatch"
        },
        {
          "properties": {
            "source": {
              "anyOf": [
                {
                  "required": ["column"]
                },
                {
                  "required": ["default_value"]
                },
                {
                  "required": ["default_from_field"]
                },
                {
                  "required": ["fixed_value"]
                }
              ],
              "not": {
                "required": ["pos"]
              }
            }
          }
        }
      ]
    }
  }
}
